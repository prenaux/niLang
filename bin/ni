#!/bin/bash
#===== PRELUDE BEGIN ===========
if [[ -z "$HAM_HOME" ]]; then echo "E/HAM_HOME not set!"; exit 1; fi
# shellcheck disable=SC2034
SCRIPT_NAME=$(basename "$0")
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
#===== PRELUDE END =============

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
. "$SCRIPT_DIR/ni-bash-setenv.sh" ra

INCLUDE_DIRS=(
  "$SCRIPT_DIR/../scripts"
  "$SCRIPT_DIR/../sources"
)

PARAMS=()
for dir in "${INCLUDE_DIRS[@]}"; do
  if [ -d "$dir" ]; then
    PARAMS+=(-I"$dir")
  fi
done

(
  # set -x
  "${NI_EXE}" "${PARAMS[@]}" "$@"
)
