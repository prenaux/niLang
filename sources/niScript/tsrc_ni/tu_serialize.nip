::Import("unittest.ni")
::Import("fs.ni")
::Import("seq.ni")

::FIXTURE(["serialize"])

// Infinite loop caused by TextEncodingFormatReadString not trying to read any
// data when reading an empty serialize. That leads to fp.partial_read never
// returning true.
::TEST("serialize","int", #() {
  local obj = { v = 123 }
  local fp = ::gLang.CreateFileDynamicMemory(0,"--string--")
  {
    ::SerializeWriteObject(fp,obj);
    local size = fp.GetSize();
    //::CHECK_EQUAL(31,size);
  }
  fp.SeekSet(0)
  {
    local loaded = ::SerializeReadObject(fp)
  }
})
