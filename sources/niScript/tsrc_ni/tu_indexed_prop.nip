::Import("unittest.ni")
::Import("lang.ni")

::FIXTURE("IndexedProperty")

::TEST("IndexedProperty" "indexed_u32" #{
  local objIndexedProp
  {
    local obj = ::DT("TestDT")
    ::CHECK_EQUAL(0,obj.num_properties);
    obj.int["testprop"] = 123
    ::CHECK_EQUAL(123,obj.int["testprop"]);
    ::CHECK_EQUAL(1,obj.num_properties);
    ::CHECK_EQUAL(2,obj.GetNumRefs());

    objIndexedProp = obj.int
    ::LINT_CHECK_TYPE("property_def<iDataTable,set:SetInt,get:GetInt>",objIndexedProp);
    ::CHECK_EQUAL(3,obj.GetNumRefs());
    objIndexedProp["testprop"] = 888
    ::CHECK_EQUAL(888,objIndexedProp["testprop"]);
    ::CHECK_EQUAL(888,obj.int["testprop"]);
    ::CHECK_EQUAL(1,obj.num_properties);

    ::dbg("num refs:" obj.GetNumRefs())
    obj = null;
  }

  objIndexedProp["testprop"] = 777
  ::CHECK_EQUAL(777,objIndexedProp["testprop"]);
})
