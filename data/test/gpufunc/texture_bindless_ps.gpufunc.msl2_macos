#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 OUT_0_rval_color [[color(0)]];
};

struct main0_in
{
    float4 IN_1_aInput_color [[user(locn1)]];
    float2 IN_2_aInput_tex0 [[user(locn2)]];
};

fragment main0_out main0(main0_in in [[stage_in]], array<texture2d<float>, 1> nil_builtin_AllTextures2D [[texture(0)]], sampler IN_1_aSS [[sampler(0)]])
{
    main0_out out = {};
    out.OUT_0_rval_color = nil_builtin_AllTextures2D[0].sample(IN_1_aSS, in.IN_2_aInput_tex0) * in.IN_1_aInput_color;
    return out;
}

