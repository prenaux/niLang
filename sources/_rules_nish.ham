
NISH_RUN_EXE = [ FDirName $(WORK) Playground bin nish ] ;
NISH_GLSLANG_OPT_FLAGS = -Os ;
NISH_SPIRV_OPT_FLAGS = -O ;

rule GeneratedWith {
  # ECHO "GENERATED WITH: '$(<)' WITH '$(>)'." ;
  DEPENDS $(<) : $(>) ;
  if ! [ FExists $(<) ] {
    # ECHO "GENERATED WITH: '$(<)' DOESNT EXIST, ALWAYS '$(>)'." ;
    ALWAYS $(>) ;
  }
}
actions GeneratedWith {
  . "$HAM_HOME/bin/ham-bash-setenv.sh"
  if [ ! -e "$(>)" ]; then
    log_error "GeneratedWith: Cant find expected source file '$(>)' that also generates '$(<)'."
    exit 1
  fi
  if [ ! -e "$(<)" ]; then
    log_error "GeneratedWith: Cant find expected output file '$(<)' that should have been generated with '$(>)'"
    exit 1
  fi
}

# nishCompileGlsl_ [ gpufunc targets ] : INPUT.glsl : STAGE : GPU_TARGETS
rule nishCompileGlsl_ {
  local OUTPUT = [ ListGetFirst $(1) ] ;
  # logInfoVar OUTPUT ;
  local OUT_DIR = $(OUTPUT:D) ;
  # logInfoVar OUT_DIR ;
  local OUT_GPUFUNC = [ FDirName $(OUT_DIR) $(OUTPUT:B) ] ;
  # logInfoVar OUT_GPUFUNC ;
  local BASENAME = $(OUT_GPUFUNC:B) ;
  # logInfoVar BASENAME ;
  local INPUT = $(2) ;
  # logInfoVar INPUT ;
  local STAGE = $(3) ;
  # logInfoVar STAGE ;
  local GPU_TARGETS = $(4) ;
  # logInfoVar GPU_TARGETS ;

  _BASENAME on $(<) = $(BASENAME) ;
  _STAGE on $(<) = $(STAGE) ;
  _INPUT on $(<) = $(INPUT) ;
  _OUT_GPUFUNC on $(<) = $(OUT_GPUFUNC) ;
  _GPU_TARGETS on $(<) = $(GPU_TARGETS:J=,) ;

  DEPENDS $(<) : $(INPUT) ;
  return $(<) ;
}
actions nishCompileGlsl_ {
  $(NISH_RUN_EXE) \
    @glslang $(NISH_GLSLANG_OPT_FLAGS) -S $(_STAGE) --target-env vulkan1.2 -V -o "$(_INPUT).spv" "$(_INPUT)"\
    @spirv-opt $(NISH_SPIRV_OPT_FLAGS) "$(_INPUT).spv" -o "$(_OUT_GPUFUNC).spv_vk12"\
    @nish -S $(_STAGE) -n "$(_BASENAME)" -t $(_GPU_TARGETS) "$(_OUT_GPUFUNC).spv_vk12" "$(_OUT_GPUFUNC).xml"\
    @rm "$(_INPUT).spv"
}

# nishCompileGlsl TARGET.gpufunc.xml : INPUT.glsl : STAGE : GPU_TARGETS
rule nishCompileGlsl {
  local langOutputs = ;
  for _gpuTarget in $(4) {
    local t = $(1:S=.$(_gpuTarget)) ;
    # logInfoVar t ;
    langOutputs += $(t) ;
  }
  logInfoVar langOutputs ;
  return [ nishCompileGlsl_ $(1) $(langOutputs) : $(2) : $(3) : $(4) ] ;
}

# nilGenerateGpufunc OUTPUT : GENERATOR_SCRIPT
rule nilGenerate {
}
actions nilGenerate {
  # ${WORK}/bin/nt-x64/ni_ra.exe -DniScript.NoLint=1 -I${WORK}/niLang/scripts -I${WORK}/Vlk/scripts -I${WORK}/Playground/scripts -e "$WORK/Playground/sources/nilTests/Shader_Base_glsl450.nip" "$WORK/niLang/data/test/gpufunc/TestGpuFuncs.hpp"
}
