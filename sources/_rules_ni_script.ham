
NI_RUN_EXE = [ FDirName $(NILANG_BUILD_DIR_BIN) ni_$(BUILDEXT)$(BUILD_SUFEXE) ] ;
NIW_RUN_EXE = [ FDirName $(NILANG_BUILD_DIR_BIN) ni_$(BUILDEXT)$(BUILD_SUFEXE) ] ;

# niRunInDir WHAT : INDIR : PARAMS ;
rule niRunInDir {
  runInDir_ Run_$(<) : $(NI_RUN_EXE) : $(2) : $(3) ;
  runInDebugger_ Debug_$(<) : $(NI_RUN_EXE) : $(2) : $(3) ;
  DEPENDS Run_$(<) : $(<) ;
  DEPENDS Debug_$(<) : $(<) ;
}
rule niwRunInDir {
  runInDir_ Run_$(<) : $(NIW_RUN_EXE) : $(2) : $(3) ;
  runInDebugger_ Debug_$(<) : $(NIW_RUN_EXE) : $(2) : $(3) ;
  DEPENDS Run_$(<) : $(<) ;
  DEPENDS Debug_$(<) : $(<) ;
}

# niFindScriptSrc SRC ;
rule niFindScriptSrc {
  local _i ;
  local r ;
  for _i in [ FGristFiles $(<) ] {
    r += [ FDirName $(SEARCH_SOURCE) $(_i) ] ;
  }
  return $(r) ;
}

rule niToolkitScriptDirs {
  local _tk ;
  local r ;
  for _tk in $(1) {
    r += [ FDirName [ tkFindToolkitDir $(_tk) ] scripts ] ;
    r += [ FDirName [ tkFindToolkitDir $(_tk) ] sources ] ;
  }
  return $(r) ;
}

# niScript TARGET : MAIN : SRC : SCRIPT_INCS ;
rule niScript {
  local TARGET = $(1) ;
  local SRC = [ niFindScriptSrc $(2) ] ;
  local APPSCRIPT ;

  local SCRIPT_INCS =
    [ niToolkitScriptDirs niLang ]
  ;
  if $(4) {
    SCRIPT_INCS += $(4) ;
  }
  SCRIPT_INCS = [ FIncludesDash [ FQuote $(SCRIPT_INCS) ] ] ;

  if $(2:S) = .nip {
    APPSCRIPT = -e $(2) ;
    NI_APPSCRIPT on Run_$(TARGET) = $(APPSCRIPT) ;
    NI_APPSCRIPT on Debug_$(TARGET) = $(APPSCRIPT) ;
    niRunInDir $(TARGET) : $(SUBDIR) : $(SCRIPT_INCS) -e $(2) ;
    tkDepExe $(TARGET) : ni : niLang ;
  }
  else if $(2:S) = .niw {
    APPSCRIPT = -A main -e $(2) ;
    NI_APPSCRIPT on Run_$(TARGET) = $(APPSCRIPT) ;
    NI_APPSCRIPT on Debug_$(TARGET) = $(APPSCRIPT) ;
    niwRunInDir $(TARGET) : $(SUBDIR) : $(SCRIPT_INCS) -A main -e $(2) ;
    # tkDepExe $(TARGET) : niw : niLang ;
  }
  else {
    APPSCRIPT = -A niScript -e app.ni -startApp $(2) ;
    NI_APPSCRIPT on Run_$(TARGET) = $(APPSCRIPT) ;
    NI_APPSCRIPT on Debug_$(TARGET) = $(APPSCRIPT) ;
    niwRunInDir $(TARGET) : $(SUBDIR) : $(SCRIPT_INCS) -A niTest -e app.ni -startApp $(2) ;
    # tkDepExe $(TARGET) : niw : niLang ;
  }

  DEPENDS $(TARGET) : $(SRC) ;
}

# niScriptTest TARGET : MAIN : SRC : SCRIPT_INCS ;
rule niScriptTest {
  local TARGET = $(1) ;
  niScript $(TARGET) : $(2) : $(3) : $(4) ;
  DEPENDS tests : $(TARGET) ;
  return $(TARGET) ;
}

# niGeneratorScript OUTPUT(S) : GENERATOR_SCRIPT : SCRIPT_PARAMETERS
rule niGeneratorScript {
  local OUTPUTS = $(1) ;
  local FIRST_OUTPUT = [ ListGetFirst $(1) ] ;
  local GENERATOR_SCRIPT = [ AssertFExists niGeneratorScript : $(2) ] ;
  local SCRIPT_PARAMS = $(3) ;
  _OUTPUTS on $(<) = $(OUTPUTS) ;
  _GEN_SCRIPT on $(<) = $(GENERATOR_SCRIPT) ;
  _SCRIPT_PARAMS on $(<) = $(SCRIPT_PARAMS) ;
  local FIRST_OUTPUT = [ ListGetFirst $(OUTPUTS) ] ;
  for _o in $(OUTPUTS) {
    if $(_o) != $(FIRST_OUTPUT) {
      OutputWith $(_o) : $(FIRST_OUTPUT) : niGeneratorScript ;
    }
  }

  DEPENDS $(OUTPUTS) : $(GENERATOR_SCRIPT) ;
  return $(OUTPUTS) ;
}
actions niGeneratorScript {
  "$(NI_EXE)" -DniScript.NoLint=1\
    -I"$(WORK)/niLang/scripts"\
    -I"$(WORK)/Vlk/scripts"\
    -I"$(WORK)/Playground/scripts"\
    -I"$(WORK)/niLang/sources"\
    -I"$(WORK)/Vlk/sources"\
    -I"$(WORK)/Playground/sources"\
    -e "$(_GEN_SCRIPT)"\
    $(_SCRIPT_PARAMS)
}
