if [ SubDirOnce TOP niUI tsrc_gdrv ] = 1 { return ; }
if ! $(TARGET_FEATURE_EXE) { return ; }

tkDefTest Test_niUI_GDRV : 1.0.0 ;
niImportModuleLibs niUnitTest ;
niImportModuleDll niLang ;
niImportModuleDll_niUI ;

SRC = [ tkPkgSrc ] ;

DEPENDS $(PACKAGE)_nish : [ niBuildGpuFuncsHpp $(PACKAGE)_nish_public :
  $(TK_DIR) data test nish :
  $(WORK) Playground sources nilTests nish test_public.nip :
  TestGpuFuncs.hpp
] ;

DEPENDS $(PACKAGE)_nish : [ niBuildGpuFuncs $(PACKAGE)_nish_gpu :
  $(TK_DIR) data test nish gpu :
  $(WORK) Playground sources nilTests nish test_gpu.nip :
  triangle_vs
  triangle_ps
  texture_vs
  texture_ps
  texture_alphatest_vs
  texture_alphatest_ps
  skybox_vs
  skybox_ps
] ;

DEPENDS $(PACKAGE)_nish : [ niBuildGpuFuncs $(PACKAGE)_nish_bindless :
  $(TK_DIR) data test nish bindless :
  $(WORK) Playground sources nilTests nish test_bindless.nip :
  texture_bindless_vs
  texture_bindless_ps
] ;

DEPENDS $(PACKAGE)_nish : [ niBuildGpuFuncs $(PACKAGE)_nish_rayquery :
  $(TK_DIR) data test nish rayquery :
  $(WORK) Playground sources nilTests nish test_rayquery.nip :
  triangle_rayquery_ps
  sphere_rayquery_ps
] ;

DEPENDS $(PACKAGE)_nish : [ niBuildGpuFuncs $(PACKAGE)_nish_raypipeline :
  $(TK_DIR) data test nish raypipeline :
  $(WORK) Playground sources nilTests nish test_raypipeline.nip :
  triangle_rgen
  triangle_rmiss
  triangle_rchit
  triangle_instanceindex_rchit
  triangle_instanceid_rchit
  triangle_bary_rchit
  sphere_rint
] ;

DEPENDS $(PACKAGE) : $(PACKAGE)_nish ;

BUILD_SRC = [ tkBuildPackage $(SRC) : exc data : $(CHK_SOURCES) ] ;

runInDir Test_niUI_GDRV ;
