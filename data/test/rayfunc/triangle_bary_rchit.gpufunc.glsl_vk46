#version 460
#extension GL_EXT_ray_tracing : require

struct lib_shader_RayPayload
{
    vec4 color;
    float hitT;
};

struct lib_shader_RayHitPayload
{
    vec2 baryCoord;
};

hitAttributeEXT lib_shader_RayHitPayload _hitAttributeEXT_RayHitPayload;
layout(location = 0) rayPayloadInEXT lib_shader_RayPayload nil_builtin_RAY_PAYLOAD_0;

void main()
{
    nil_builtin_RAY_PAYLOAD_0 = lib_shader_RayPayload(vec4(_hitAttributeEXT_RayHitPayload.baryCoord, 0.0, 1.0), gl_RayTmaxEXT);
}

