if [ SubDirOnce TOP niUI tsrc_niui ] = 1 { return ; }
if ! $(TARGET_FEATURE_CONSOLE) { return ; }

tkDefTest Test_niUI_niui ;

SRC = [ tkPkgSrc niui ] ;

for _i in $(SRC) {
  local t = Test_niUI_niui_$(_i:B) ;
  niScriptTest $(t) : $(_i) ;
  DEPENDS $(t) : niLang niUI ni ;
  DEPENDS Test_niUI_niui : $(t) ;
  DEPENDS Run_Test_niUI_niui : Run_$(t) ;
}

tkIncludeDep TOP niLang ;
tkIncludeDep TOP niUI ;
tkIncludeDep TOP ni ;
