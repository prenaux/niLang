if [ SubDirOnce TOP niScript src ] = 1 { return ; }

tkDefModuleLib niScript : 1,0,0 : niScript ;
niImportModuleDll niLang ;

### SOURCES #############################################################
SRC = [ tkPkgSrc ] ;
BUILD_SRC = [ tkBuildPackage $(SRC) : pch lint : $(CHK_SOURCES) : $(SRC_EXTRA) ] ;
